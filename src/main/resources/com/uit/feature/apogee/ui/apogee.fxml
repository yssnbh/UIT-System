<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml">
    <TabPane styleClass="settings-tabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab closable="false" text="Déverrouillage les comptes">
                <content>
                    <VBox alignment="TOP_LEFT" spacing="14.0" styleClass="unlock-form">
                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Nom d'utilisateur"/>
                            <Label styleClass="field-subtitle" text="Un ou plusieurs noms, séparés par ;" wrapText="true"/>
                            <TextField fx:id="usernames"/>
                        </VBox>
                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Mot de passe"/>
                            <Label styleClass="field-subtitle" text="Appliqué à chaque compte" wrapText="true"/>
                            <TextField fx:id="password" text="123456"/>
                        </VBox>
                        <Button fx:id="unlock" onAction="#unlockAccounts" styleClass="primary-button" text="Déverrouillage le compte"/>
                        <VBox fx:id="statistics" managed="false" spacing="10.0" visible="false">
                            <HBox spacing="10.0">
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="unlockedCount" styleClass="stat-value" text="0"/>
                                    <Label styleClass="stat-label" text="Unlocked"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="missingCount" styleClass="stat-value stat-missing" text="0"/>
                                    <Label styleClass="stat-label" text="User not exists"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="errorCount" styleClass="stat-value stat-error" text="0"/>
                                    <Label styleClass="stat-label" text="Errors"/>
                                </VBox>
                            </HBox>
                            <TextArea fx:id="result" editable="false" prefRowCount="5" styleClass="unlock-result" wrapText="true"/>
                        </VBox>
                        <padding>
                            <Insets top="4.0"/>
                        </padding>
                    </VBox>
                </content>
            </Tab>
            <Tab closable="false" text="Verrouillage les comptes">
                <content>
                    <VBox alignment="TOP_LEFT" spacing="14.0" styleClass="unlock-form">
                        <VBox spacing="6.0">
                            <Label styleClass="field-label" text="Nom d'utilisateur"/>
                            <Label styleClass="field-subtitle" text="Un ou plusieurs noms, séparés par ;" wrapText="true"/>
                            <TextField fx:id="lockUsernames"/>
                        </VBox>
                        <Button fx:id="lock" onAction="#lockAccounts" styleClass="primary-button" text="Verrouillage le compte"/>
                        <VBox fx:id="lockStatistics" managed="false" spacing="10.0" visible="false">
                            <HBox spacing="10.0">
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lockedCount" styleClass="stat-value" text="0"/>
                                    <Label styleClass="stat-label" text="Locked"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lockMissingCount" styleClass="stat-value stat-missing" text="0"/>
                                    <Label styleClass="stat-label" text="User not exists"/>
                                </VBox>
                                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                    <Label fx:id="lockErrorCount" styleClass="stat-value stat-error" text="0"/>
                                    <Label styleClass="stat-label" text="Errors"/>
                                </VBox>
                            </HBox>
                            <TextArea fx:id="lockResult" editable="false" prefRowCount="5" styleClass="unlock-result" wrapText="true"/>
                        </VBox>
                        <padding>
                            <Insets top="4.0"/>
                        </padding>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
